# Copiar para /etc/bots.env (chmod 600, dono bots). Nada aqui é segredo: as chaves ficam em BOTS_KEYS_DIR.
BOTS_HOST=127.0.0.1
BOTS_PORT=5000
BOTS_DATA_DIR=/var/lib/bots/data
BOTS_KEYS_DIR=/var/lib/bots/keys
# Ligar quando o painel estiver atrás de HTTPS (Caddy/nginx) ou de uma VPN com HTTPS:
# BOTS_HTTPS=1
